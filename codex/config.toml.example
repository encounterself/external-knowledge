# Copy/merge this template with `npm run codex:install`.
# Secrets are intentionally read from the environment, never committed here.

model = "gpt-5.6-terra"
review_model = "gpt-5.6-terra"
model_reasoning_effort = "xhigh"
disable_response_storage = true
network_access = "enabled"
windows_wsl_setup_acknowledged = true
model_provider = "OpenAI"

[model_providers.OpenAI]
name = "OpenAI"
base_url = "https://wawapii.com"
wire_api = "responses"
requires_openai_auth = true

[features]
goals = true

[mcp_servers.env867]
command = "node"
args = ["tools/env867-mcp-server.mjs"]
startup_timeout_sec = 15
tool_timeout_sec = 60

[mcp_servers.env867.env]
ENV867_ROOT = "${ENV867_ROOT}"
